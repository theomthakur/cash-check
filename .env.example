# Public app URL, without a trailing slash.
APP_URL=http://localhost:3000

# SnapTrade OAuth application credentials.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CLIENT_SECRET=

# Neon/Postgres connection string.
DATABASE_URL=

# Generate each value independently. Do not reuse them.
# TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes (base64url).
TOKEN_ENCRYPTION_KEY=
SESSION_SIGNING_SECRET=
OAUTH_COOKIE_SECRET=
